{
  "name": "docintel-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test e2e/smoke.spec.ts",
    "walkthrough": "playwright test e2e/walkthrough.spec.ts --project=walkthrough",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "DocIntel web app: upload, monitor, review, correct, search and cross-verify invoices",
  "engines": {
    "node": ">=20.9"
  }
}