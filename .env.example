# Copy to .env (git-ignored) and adjust. docker compose reads it automatically.

# --- Security -------------------------------------------------------------------------------
# Comma-separated name:key pairs (keys >= 12 chars). The name is recorded as the actor in audit logs.
API_KEYS=admin:dev-admin-key-change-me
# Key the web app's server-side proxy uses (must be one of API_KEYS). Never exposed to browsers.
WEB_API_KEY=dev-admin-key-change-me
# Optional basic auth for the web UI, "user:password" (the user name is attributed in corrections).
WEB_BASIC_AUTH=
CORS_ORIGINS=http://localhost:3000

# --- AI extraction ----------------------------------------------------------------------------
# auto | azure-openai | anthropic | none   (none = deterministic rules only)
LLM_PROVIDER=auto
# fallback = cascade (LLM only when rules are incomplete/uncertain) | always | never
LLM_STRATEGY=fallback
LLM_CONCURRENCY=4
# Send page images to the model when OCR quality is low
LLM_VISION_FALLBACK=true

# Azure OpenAI / Azure AI Foundry (v1 API)
AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra
AZURE_OPENAI_REASONING_EFFORT=low

# Anthropic Claude (alternative provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Processing -------------------------------------------------------------------------------
MAX_UPLOAD_MB=200
PAGE_CHUNK_SIZE=16
WORKER_CONCURRENCY_PAGES=4
WORKER_CONCURRENCY_ANALYZE=6
PROCESSOR_WORKERS=4
EMBEDDING_PROVIDER=fastembed
